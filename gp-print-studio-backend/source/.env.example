#--------------------------------------------------------------------
# Example Environment Configuration file
#
# This file can be used as a starting point for your own
# custom .env files, and contains most of the possible settings
# available in a default install.
#
# By default, all of the settings are commented out. If you want
# to override the setting, you must un-comment it by removing the '#'
# at the beginning of the line.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'http://localhost:8080/'
# If you have trouble with `.`, you could also use `_`.
# app_baseURL = ''
# app.forceGlobalSecureRequests = false
# app.CSPEnabled = false

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
# 1. Base de datos principal (PostgreSQL)
database.default.hostname = localhost
database.default.database = postgres
database.default.username = postgres
database.default.password = your_secret_password
database.default.DBDriver = Postgre
database.default.port = 5432

# 2. Segunda base de datos (SQL Server)
database.default.hostname = localhost
database.default.database = database
database.default.username = sa
database.default.password = your_secret_password
database.default.DBDriver = SQLSRV
database.default.DBPrefix =
database.default.port = 1433

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------

# encryption.key =

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------

# session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
# session.savePath = null

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------

# logger.threshold = 4

#--------------------------------------------------------------------
# IDENTITY API
#--------------------------------------------------------------------
IDENTITY_API_URL=https://auth.gruposerex.com/api
IDENTITY_API_JWKS_URI=https://auth.gruposerex.com/api/.well-known/jwks.json


{
	"info": {
		"_postman_id": "b1b2a9e3-85f0-4966-9b34-8c8f0f353a25",
		"name": "GP Print Studio API",
		"description": "API endpoints para GP Print Studio. Incluye listado, detalle de documentos y gestión de formatos de impresión.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "System",
			"item": [
				{
					"name": "Health Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/health",
							"host": ["{{base_url}}"],
							"path": ["health"]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Documents",
			"item": [
				{
					"name": "Get Document Summary List",
					"request": {
						"method": "GET",
						"header": [
							{"key": "Accept", "value": "application/json", "type": "text"}
						],
						"url": {
							"raw": "{{base_url}}/api/documents/summary?page=1&per_page=10",
							"host": ["{{base_url}}"],
							"path": ["api", "documents", "summary"],
							"query": [
								{"key": "page", "value": "1"},
								{"key": "per_page", "value": "10"}
							]
						}
					},
					"response": []
				},
				{
					"name": "Get Document Details",
					"request": {
						"method": "GET",
						"header": [
							{"key": "Accept", "value": "application/json", "type": "text"}
						],
						"url": {
							"raw": "{{base_url}}/api/documents/FACT-001/details",
							"host": ["{{base_url}}"],
							"path": ["api", "documents", "FACT-001", "details"]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Formats (Print Layouts)",
			"item": [
				{
					"name": "1. Listar Formatos",
					"request": {
						"method": "GET",
						"header": [{"key": "Accept", "value": "application/json"}],
						"url": {
							"raw": "{{base_url}}/api/formats",
							"host": ["{{base_url}}"],
							"path": ["api", "formats"]
						}
					},
					"response": []
				},
				{
					"name": "2. Crear Formato (Maestro)",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Accept", "value": "application/json"},
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Factura USD Pre-impresa\",\n  \"description\": \"Diseño oficial para facturas en dólares 2026\",\n  \"document_type_id\": 3\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/formats",
							"host": ["{{base_url}}"],
							"path": ["api", "formats"]
						}
					},
					"response": []
				},
				{
					"name": "3. Obtener Detalle de Formato",
					"request": {
						"method": "GET",
						"header": [{"key": "Accept", "value": "application/json"}],
						"url": {
							"raw": "{{base_url}}/api/formats/<FORMAT_ID>",
							"host": ["{{base_url}}"],
							"path": ["api", "formats", "<FORMAT_ID>"]
						}
					},
					"response": []
				},
				{
					"name": "4. Guardar Nueva Versión (Canvas)",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Accept", "value": "application/json"},
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"layout_json\": {\n    \"canvas_width\": 800,\n    \"canvas_height\": 1100,\n    \"elements\": [\n      {\"type\": \"text\", \"content\": \"Factura Legal\", \"x\": 10, \"y\": 50},\n      {\"type\": \"variable\", \"field\": \"customer_name\", \"x\": 10, \"y\": 100}\n    ]\n  }\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/formats/<FORMAT_ID>/versions",
							"host": ["{{base_url}}"],
							"path": ["api", "formats", "<FORMAT_ID>", "versions"]
						}
					},
					"response": []
				},
				{
					"name": "5. Ver Historial de Versiones",
					"request": {
						"method": "GET",
						"header": [{"key": "Accept", "value": "application/json"}],
						"url": {
							"raw": "{{base_url}}/api/formats/<FORMAT_ID>/versions",
							"host": ["{{base_url}}"],
							"path": ["api", "formats", "<FORMAT_ID>", "versions"]
						}
					},
					"response": []
				}
			]
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8080",
			"type": "string"
		}
	]
}

# Copia este archivo como .env (no se sube a git).
# Los valores por defecto coinciden con el docker-compose.yml de la raíz.

PORT=3000
# Orígenes que pueden llamar a la API (frontend de Vite). Separa varios con comas.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Base de datos PostgreSQL (docker compose up -d en la raíz)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dndfacturas
DB_USER=dndfacturas
DB_PASSWORD=dndfacturas_dev
# true = muestra las consultas SQL en consola
DB_LOGGING=false

# API de facturas de Dynamics. {numero} = número de factura.
# Por defecto: la API simulada (npm run mock-api en la raíz).
DYNAMICS_API_URL=http://localhost:3001/facturas/{numero}
# Token/clave de Dynamics: se queda en el servidor, nunca llega al navegador.
DYNAMICS_API_TOKEN=
DYNAMICS_API_TIMEOUT_MS=10000

{
  "name": "dndfacturas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix frontend run dev -- --mode development",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "preview": "npm --prefix frontend run preview",
    "frontend:install": "npm --prefix frontend install",
    "mock-api": "node mock-api/server.js",
    "db:seed": "node database/scripts/generate-seed.mjs",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "backend:dev": "npm --prefix backend run start:dev",
    "gp-print-studio:up": "docker compose -f gp-print-studio-backend/docker-compose.yml up -d --build",
    "gp-print-studio:down": "docker compose -f gp-print-studio-backend/docker-compose.yml down",
    "backend:test": "npm --prefix backend test && npm --prefix backend run test:e2e"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-rnd": "^10.5.3",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}

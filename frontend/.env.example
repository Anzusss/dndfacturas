# ==============================================================================
# Grupo Serex Admin Template - Archivo de Ejemplo de Variables de Entorno
# Copia este archivo a `.env.local` o `.env` para personalizar la configuración local.
# ==============================================================================

# URL base de la API Backend (REST / GraphQL)
VITE_API_BASE_URL=https://api.serex.com/v1
VITE_AUTH_API_URL="https://auth.gruposerex.com/api"
VITE_DOCUMENTS_API_URL=http://localhost:8080/api

# ID del cliente de la API de Identity (para usar en las peticiones)
VITE_CLIENT_ID_IDENTITY=your_client_id_auth

# Nombre público de la aplicación
VITE_APP_TITLE="Admin Panel - GP Print Studio"

# Tasa de Impuesto IVA por defecto (Ejemplo: 0.16 representa 16%)
VITE_DEFAULT_TAX_RATE=0.16
º
# Habilitar Servidor / Datos Mock en Desarrollo (true / false)
VITE_ENABLE_MOCK_DATA=true

# Tiempo de expiración de sesión (en minutos)
VITE_SESSION_TIMEOUT_MINUTES=60

# Copia este archivo como .env.local y ajusta los valores.
# Las variables VITE_* son PUBLICAS (quedan en el JS del navegador): no pongas claves secretas.

# URL de la API de facturas. {numero} se sustituye por el numero de factura.
# Si se deja vacia, la app usa el modo simulado (src/services/invoiceApi/mockInvoices.js).
VITE_INVOICE_API_URL=

# --- Base de datos (docker-compose.yml) ---------------------------------------
# Valores de DESARROLLO. En otros entornos usa contraseñas propias y no subas .env a git.
POSTGRES_DB=dndfacturas
POSTGRES_USER=dndfacturas
POSTGRES_PASSWORD=dndfacturas_dev
POSTGRES_PORT=5432
ADMINER_PORT=8080

# --- Backend NestJS ------------------------------------------------------------
# Si se define, la app guarda y lee todo del backend (PostgreSQL) en vez de localStorage.
# También puedes usar "npm run dev:backend", que lo toma de .env.backend.
VITE_BACKEND_URL=

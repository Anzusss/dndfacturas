# PostgreSQL usado por el stack raíz
# PostgreSQL único (conserva el volumen de GP Print Studio).
PG_CONTAINER_NAME=gp-print-studio-postgres
PG_PORT=5432
PG_USER=postgres
PG_DATABASE=gp_print_studio_db

# --- Servicios temporales de GP Print Studio ----------------------------------
APP_PORT=8080
APP_CONTAINER_NAME=gp-print-studio-backend
DB_CONTAINER_NAME=gp-print-studio-database
DB_PORT=1433
DB_USER=sa
DB_DATABASE=PSGMC
DB_PASSWORD=change_me_gp

# URLs opcionales usadas por el frontend heredado o integraciones locales
VITE_BACKEND_URL=http://localhost:3000/api
VITE_INVOICE_API_URL=http://localhost:8080/api/facturas/{numero}